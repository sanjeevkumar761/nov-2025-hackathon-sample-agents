# Azure OpenAI Configuration
AZURE_OPENAI_ENDPOINT=https://your-endpoint.openai.azure.com/
AZURE_OPENAI_API_KEY=your-api-key-here
AZURE_OPENAI_DEPLOYMENT_NAME=gpt-4
AZURE_OPENAI_API_VERSION=2024-08-01-preview

# GitLab Configuration
GITLAB_URL=https://gitlab.com
GITLAB_TOKEN=your-personal-access-token-here
GITLAB_PROJECT_ID=  # Optional: Default project ID

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:5173

# App Configuration
LOG_LEVEL=INFO
APP_ENV=development

# Agile Settings
DEFAULT_STORY_POINTS_SCALE=1,2,3,5,8,13,21
DEFAULT_SPRINT_DURATION=14
ENABLE_AUTO_STORY_CREATION=true
MAX_STORY_POINTS_PER_STORY=13

# AI Behavior
AI_TEMPERATURE=0.2
MAX_TOKENS=2000

# Optional: Notifications
SLACK_WEBHOOK_URL=
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=587
EMAIL_FROM=
EMAIL_TO=

# Optional: Caching
ENABLE_CACHE=true
CACHE_TTL_SECONDS=3600
