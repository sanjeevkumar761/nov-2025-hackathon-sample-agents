# ===========================
# Azure OpenAI Configuration
# ===========================
AZURE_OPENAI_ENDPOINT=https://your-endpoint.openai.azure.com/
AZURE_OPENAI_API_KEY=your-api-key-here
AZURE_OPENAI_DEPLOYMENT_NAME=gpt-4
AZURE_OPENAI_API_VERSION=2024-02-15-preview

# ===========================
# ServiceNow Configuration
# ===========================
# Basic Auth (Option 1)
SNOW_INSTANCE=https://your-instance.service-now.com
SNOW_USERNAME=api_user
SNOW_PASSWORD=password

# OAuth (Option 2 - Recommended for Production)
# SNOW_CLIENT_ID=your-client-id
# SNOW_CLIENT_SECRET=your-client-secret

# ===========================
# Quality Scoring Thresholds
# ===========================
# Short Description
MIN_SHORT_DESC_LENGTH=10
MAX_SHORT_DESC_LENGTH=80

# Long Description
MIN_LONG_DESC_LENGTH=100
RECOMMENDED_LONG_DESC_LENGTH=300

# Resolution
MIN_RESOLUTION_LENGTH=50
RECOMMENDED_RESOLUTION_LENGTH=200

# Overall Quality
QUALITY_THRESHOLD=70
# 0-40: Poor (blocks automation)
# 41-70: Fair (needs enrichment)
# 71-90: Good (automation-ready)
# 91-100: Excellent (best practice)

# ===========================
# Dimension Weights
# ===========================
SHORT_DESC_WEIGHT=0.25
LONG_DESC_WEIGHT=0.30
CATEGORIZATION_WEIGHT=0.25
RESOLUTION_WEIGHT=0.20

# ===========================
# API Settings
# ===========================
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:5173

# ===========================
# Processing Settings
# ===========================
BATCH_SIZE=100
MAX_CONCURRENT_ENRICHMENTS=10
ENABLE_AUTO_UPDATE_SNOW=false
ENRICHMENT_TIMEOUT_SECONDS=30

# ===========================
# AI Model Settings
# ===========================
AI_TEMPERATURE=0.2
AI_MAX_TOKENS=2000
AI_TOP_P=0.95

# ===========================
# Caching (Optional)
# ===========================
ENABLE_CACHING=true
CACHE_TTL_SECONDS=3600

# ===========================
# Logging
# ===========================
LOG_LEVEL=INFO
LOG_FILE=asr_enrichment.log
ENABLE_EXECUTION_TRACE=true

# ===========================
# ServiceNow Field Mapping
# ===========================
SNOW_TABLE_INCIDENT=incident
SNOW_FIELD_SHORT_DESC=short_description
SNOW_FIELD_LONG_DESC=description
SNOW_FIELD_ASSIGNMENT_GROUP=assignment_group
SNOW_FIELD_CATEGORY=category
SNOW_FIELD_SUBCATEGORY=subcategory
SNOW_FIELD_PRIORITY=priority
SNOW_FIELD_IMPACT=impact
SNOW_FIELD_URGENCY=urgency
SNOW_FIELD_RESOLUTION=close_notes

# ===========================
# Notifications (Optional)
# ===========================
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL
# EMAIL_SMTP_SERVER=smtp.gmail.com
# EMAIL_SMTP_PORT=587
# EMAIL_FROM=asr-enrichment@company.com
# EMAIL_ALERTS_TO=itops@company.com
